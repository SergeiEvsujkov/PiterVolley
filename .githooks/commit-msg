#!/bin/sh
# Запрещает коммитить docs/data.json без сообщения, начинающегося с "data:".
# Данные обновляет ETL; ручные коммиты не должны перезаписывать свежую сборку.

msg_file="$1"
first_line=$(head -n 1 "$msg_file" 2>/dev/null)

# слияния не проверяем — у них своё сообщение и своя логика
if [ -f "$(git rev-parse --git-dir)/MERGE_HEAD" ]; then
    exit 0
fi

if git diff --cached --name-only | grep -qx 'docs/data.json'; then
    case "$first_line" in
        data:*|"data: "*) exit 0 ;;
        *)
            echo "" >&2
            echo "✗ docs/data.json меняется только коммитом с сообщением, начинающимся с 'data:'" >&2
            echo "  Пример: git commit -m 'data: обновление с сайта'" >&2
            echo "  Если файл попал в индекс случайно: git restore --staged docs/data.json" >&2
            echo "" >&2
            exit 1
            ;;
    esac
fi

exit 0
